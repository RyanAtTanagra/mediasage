# MediaSage Environment Variables
# All optional: the setup wizard and Settings page can configure everything.
# Copy this file to .env and set only what you want to manage here; a value set
# here overrides Settings (and is shown as locked there), an empty one is ignored.

# Media server selection: "plex" or "jellyfin"
# Auto-detected: if JELLYFIN_URL is set and PLEX_URL is not, defaults to "jellyfin"
#MEDIA_SERVER=plex

# Plex Server Configuration (use if MEDIA_SERVER=plex)
#PLEX_URL=http://your-plex-server:32400
#PLEX_TOKEN=your-plex-token
# Optional: Plex URL as reached from browsers/phones, if different from PLEX_URL
# (used for "Open in Plex" links and Play Now on devices that can't reach PLEX_URL)
#PLEX_PUBLIC_URL=https://plex.example.com

# Jellyfin Server Configuration (use if MEDIA_SERVER=jellyfin)
# API key: create in Jellyfin Dashboard > API Keys
#JELLYFIN_URL=http://your-jellyfin-server:8096
#JELLYFIN_TOKEN=your-jellyfin-api-key
#JELLYFIN_MUSIC_LIBRARY=Music

# LLM Provider (anthropic, openai, gemini, ollama, or custom)
# Defaults to gemini if not set. Can also be configured in UI.
#LLM_PROVIDER=gemini

# LLM Provider API Keys (set the one matching your provider)
#ANTHROPIC_API_KEY=sk-ant-your-key-here
#OPENAI_API_KEY=sk-your-key-here
#GEMINI_API_KEY=your-gemini-key-here

# Optional: Override default models (usually auto-detected from provider)
#LLM_MODEL_ANALYSIS=gemini-3.5-flash-lite
#LLM_MODEL_GENERATION=gemini-3.5-flash-lite

# =============================================================================
# Local LLM Settings (experimental)
# =============================================================================

# Ollama - runs models locally via Ollama
#LLM_PROVIDER=ollama
#OLLAMA_URL=http://localhost:11434
#OLLAMA_CONTEXT_WINDOW=32768
#LLM_MODEL_ANALYSIS=llama3:8b
#LLM_MODEL_GENERATION=llama3:8b

# Custom - any OpenAI-compatible API (OpenRouter, LM Studio, etc.)
#LLM_PROVIDER=custom
#CUSTOM_LLM_URL=https://openrouter.ai/api/v1
#CUSTOM_LLM_API_KEY=sk-or-your-key-here
#CUSTOM_LLM_MODEL=meta-llama/llama-3-8b-instruct
#CUSTOM_CONTEXT_WINDOW=32768
